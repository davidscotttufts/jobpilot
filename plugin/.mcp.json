{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--snapshot-mode",
        "none",
        "--user-data-dir",
        ".playwright-mcp",
        "--save-session",
        "--output-dir",
        ".playwright-mcp/sessions"
      ]
    }
  }
}
