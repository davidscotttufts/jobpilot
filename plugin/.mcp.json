{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--snapshot-mode",
        "none",
        "--user-data-dir",
        ".playwright-mcp",
        "--save-session",
        "--output-dir",
        ".playwright-mcp/sessions"
      ]
    },
    "upwork": {
      "type": "http",
      "url": "https://mcp.upwork.com/mcp"
    }
  }
}
