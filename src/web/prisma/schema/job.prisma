model Job {
  id          Int       @id @default(autoincrement())
  runId       String
  run         Run       @relation(fields: [runId], references: [runId], onDelete: Cascade)
  key         String
  title       String
  company     String
  location    String?
  salary      String?
  type        String?
  url         String
  board       String?
  matchScore  Int?
  matchReason String?
  status      String    @default("pending")
  appliedAt   DateTime?
  failReason  String?
  retryNotes  String?
  skipReason  String?
  description String?
  digest      String?

  @@unique([runId, key])
  @@index([runId, status])
}
