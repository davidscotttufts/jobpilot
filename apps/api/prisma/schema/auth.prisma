enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE

  @@map("verification_token_type")
}

// Single-use tokens for email verification and password reset. Hash-only; the raw value
// travels once, in the emailed link.
model VerificationToken {
  id         String                @id @default(uuid())
  userId     String                @map("user_id")
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash")
  // EMAIL_CHANGE only: the pending address, applied when the link is clicked.
  newEmail   String?               @map("new_email")
  expiresAt  DateTime              @map("expires_at")
  consumedAt DateTime?             @map("consumed_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// Web session rotation. Hash-only.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum OAuthProvider {
  GOOGLE
  GITHUB

  @@map("oauth_provider")
}

// A linked sign-in identity. Stores no provider tokens.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  // Provider-reported address at link time; informational only.
  email             String?
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // One identity per provider per user - keeps link/unlink UI unambiguous.
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

// The local agent's long-lived, revocable PAT. Hash-only, except the terminal token below.
model ApiToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  tokenHash   String    @unique @map("token_hash")
  // Encrypted raw token, set only on the reusable terminal token so the web can re-fetch it.
  tokenCipher String?   @map("token_cipher")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}
