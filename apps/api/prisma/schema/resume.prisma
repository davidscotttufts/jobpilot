model Resume {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label String

  sourceFilename  String? @map("source_filename")
  sourceMimeType  String? @map("source_mime_type")
  sourceSizeBytes Int?    @map("source_size_bytes")

  content String?
  version Int     @default(1)

  variants   ResumeVariant[]
  primaryFor User?           @relation("PrimaryResume")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("resumes")
}

model ResumeVariant {
  id       String @id @default(uuid())
  resumeId String @map("resume_id")
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  label         String
  jobUrl        String?      @map("job_url")
  applicationId String?      @map("application_id")
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  content   String
  diffNotes String? @map("diff_notes")

  // JSON audit of model-authored bullet rewrites applied to this variant:
  // { experience: [{ entryIndex, company, bullets: [{ original, tailored, flags[] }] }] }.
  // Null when the variant used selection/reordering only (no rewording).
  rewrites String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resumeId])
  @@index([applicationId])
  @@map("resume_variants")
}
