enum CampaignSource {
  search
  auto_apply @map("auto-apply")
  apply
  networking
}

enum CampaignStatus {
  in_progress
  paused
  completed
  failed
}

model Campaign {
  // DB-side default so raw SQL inserts (agent skills) get ids without Prisma.
  campaignId  String         @id @default(dbgenerated("(gen_random_uuid())::text")) @map("campaign_id")
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  query       String
  source      CampaignSource
  status      CampaignStatus @default(in_progress)
  startedAt   DateTime       @default(now()) @map("started_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  completedAt DateTime?      @map("completed_at")
  config      Json           @default("{}")

  jobs               Job[]
  applications       Application[]
  networkingMessages NetworkingMessage[]

  @@index([userId, startedAt])
  @@index([userId, status, startedAt])
  @@index([userId, source, startedAt])
  @@map("campaigns")
}
