model Credential {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String
  email     String?
  password  String?
  apiKey    String? @map("api_key")

  @@unique([userId, scope])
  @@index([userId])
  @@map("credentials")
}
