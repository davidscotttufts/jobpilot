enum CampaignJobStatus {
  queued
  pending
  approved
  applying
  applied
  failed
  skipped
  needs_user
}

model Job {
  id          String            @id @default(uuid())
  campaignId  String            @map("campaign_id")
  campaign    Campaign          @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
  key         String
  title       String
  company     String
  location    String?
  salary      String?
  type        String?
  url         String
  board       String?
  matchScore  Int?              @map("match_score")
  matchReason String?           @map("match_reason")
  status      CampaignJobStatus @default(pending)
  appliedAt   DateTime?         @map("applied_at")
  /// Stamped immediately before the agent submits the form - the point after which a retry may
  /// send a second real application. Recovery hands every interrupted apply to a human regardless;
  /// the stamp only sharpens the question from "we cannot tell" to "you were mid-submit".
  submitAttemptedAt DateTime?   @map("submit_attempted_at")
  failReason  String?           @map("fail_reason")
  retryNotes  String?           @map("retry_notes")
  skipReason  String?           @map("skip_reason")
  description String?
  digest      String?
  /// Per-phase apply durations in ms, as reported by the worker. Nothing else can see inside an
  /// apply: the claim knows only that five minutes passed.
  phaseTimings Json?    @map("phase_timings")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([campaignId, key])
  @@index([campaignId, status])
  @@index([status, updatedAt])
  // The pilot activity probe takes MAX(updatedAt) across a user's campaigns every two minutes.
  @@index([campaignId, updatedAt])
  @@map("jobs")
}
