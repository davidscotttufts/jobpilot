{
  "name": "jobpilot",
  "version": "2.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --restart-tries 3 --restart-after 2000 -n terminal,api,web -c cyan,magenta,green \"dotnet run --project apps/terminal\" \"bun --cwd=apps/api run dev\" \"bun --cwd=apps/web run dev\"",
    "dev:api": "bun --cwd=apps/api run dev",
    "dev:web": "bun --cwd=apps/web run dev",
    "dev:terminal": "dotnet run --project apps/terminal",
    "test": "bun --cwd=apps/api run test && bun --cwd=packages/contracts run test",
    "db:tunnel": "bash apps/api/scripts/db-tunnel.sh",
    "db:setup": "bun --cwd=apps/api run db:generate && bun --cwd=apps/api run db:migrate:apply && bun --cwd=apps/api run db:seed",
    "db:backup": "bash apps/api/scripts/db-backup.sh",
    "db:restore": "bash apps/api/scripts/db-restore.sh",
    "report:phases": "bun --cwd=apps/api run report:phases",
    "build:api": "bun --cwd=apps/api run build",
    "build:web": "bun --cwd=apps/web run build",
    "build:terminal": "dotnet publish apps/terminal -c Release -o dist/terminal",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "ci": "biome ci --error-on-warnings .",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "concurrently": "^10.0.5",
    "knip": "^6.38.0"
  }
}
