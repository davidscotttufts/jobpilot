node_modules/
.playwright-mcp/
.playwright-mcp-2/
.playwright-mcp-test/

# Skill scratch output. The rule lives in plugin/skills/_shared/setup.md "Scratch files".
.temp/
# A pilot cycle drops its id here for the shell it drives; rewritten every cycle, and the suffix
# has already changed once (_env, then _id), so match the family rather than the filename.
.temp_cycle_*
*.pdf
*.csv
*.tsv

# Repo root is source only. Ignore strays by location - `snapshot-*.md` guessed at
# filenames and missed job-header.md / results-p2.md.
/*.md
# Screenshots dropped at the root while driving the app. Every real image lives under
# apps/web/public/ or docs/images/, so nothing tracked is caught by this.
/*.png
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/CHANGELOG.md
/*.json
!/package.json

.claude/settings.local.json
*/**/.claude/settings.local.json

# Generated by the terminal host so Codex discovers the bundled JobPilot skills.
.agents/skills/

# .NET
bin/
obj/
*.user
dist/
.tmp/

.idea/
.VSCodeCounter/

.env

# local-only credentials (never commit)
.credentials.local

# Database dumps: real applications and profile data, never committed.
backups/
